{
  "name": "Push hello world devcontainer",
  "dockerComposeFile": "compose.yaml",
  "service": "push-hello-world-devcontainer",
  "workspaceFolder": "/workspace",
  "initializeCommand": "docker-compose.exe -f ../../../ableton-os-devcontainer/compose.yaml build ableton-os-devcontainer",
  "customizations": {
    "vscode": {
      "extensions": [
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.makefile-tools",
        "cheshirekow.cmake-format",
        "xaver.clang-format"
      ]
    }
  }
}
